<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FA">

        <!-- Header Section -->
        <View
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/green_kuan"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:text="胎儿体重计算"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fetal Weight Estimation"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/tv_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <!-- Main Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/main_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@+id/bottom_container"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            android:layout_marginTop="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Biometric Inputs Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_biometrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/ll_standard_biometrics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <!-- Pregnancy Week & BPD -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tv_label_pregnancy_week"
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="孕周(周)"
                                    android:textColor="@color/green_kuan"
                                    android:textSize="13sp"
                                    android:clickable="true"
                                    android:focusable="true"/>
                                <EditText
                                    android:id="@+id/etPregnancyWeek"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="手动输入"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                                <View android:layout_width="16dp" android:layout_height="0dp" />
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="双顶径(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etBPD"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="31-100"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="6dp" />

                            <!-- HC & AC -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="头围(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etHC"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="请输入"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                                <View android:layout_width="16dp" android:layout_height="0dp" />
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="腹围(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etAC"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="200-400"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="6dp" />

                            <!-- FL & HL -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="股骨(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etFL"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="40-83"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                                <View android:layout_width="16dp" android:layout_height="0dp" />
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="肱骨(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etHL"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="请输入"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="6dp" />

                            <!-- Ulna & Tibia -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="尺骨(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etUlna"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="请输入"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                                <View android:layout_width="16dp" android:layout_height="0dp" />
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="胫骨(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etTibia"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="请输入"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_early_pregnancy_biometrics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/tv_label_back"
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="孕囊直径"
                                    android:textColor="@color/green_kuan"
                                    android:textSize="13sp"
                                    android:clickable="true"
                                    android:focusable="true"/>
                                <EditText
                                    android:id="@+id/etGSAvg"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="均值(mm)"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                                <View android:layout_width="16dp" android:layout_height="0dp" />
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="顶臀长(mm)"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etCRL"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="请输入"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="6dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="孕囊径线1"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etGS1"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="mm"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                                <View android:layout_width="16dp" android:layout_height="0dp" />
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="孕囊径线2"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etGS2"
                                    android:layout_width="0dp"
                                    android:layout_height="32dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="mm"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="6dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="65dp"
                                    android:layout_height="wrap_content"
                                    android:text="孕囊径线3"
                                    android:textColor="#444444"
                                    android:textSize="13sp" />
                                <EditText
                                    android:id="@+id/etGS3"
                                    android:layout_width="110dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/edittext_border_frame"
                                    android:hint="mm"
                                    android:inputType="numberDecimal"
                                    android:paddingHorizontal="8dp"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dates Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">
                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="末次月经"
                            android:textColor="#444444"
                            android:textSize="13sp" />
                        <EditText
                            android:id="@+id/LMP"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_border_frame"
                            android:hint="YYYYMMDD"
                            android:inputType="number"
                            android:paddingHorizontal="8dp"
                            android:textSize="13sp" />
                        <View android:layout_width="16dp" android:layout_height="0dp" />
                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="检查日期"
                            android:textColor="#444444"
                            android:textSize="13sp" />
                        <EditText
                            android:id="@+id/etInspectionDate"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:background="@drawable/edittext_border_frame"
                            android:hint="YYYYMMDD"
                            android:inputType="number"
                            android:paddingHorizontal="8dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Result Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="预测结果"
                            android:textColor="#444444"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPredictedWeight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="4dp"
                            android:text=""
                            android:textColor="@color/green_kuan"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Report Section -->
                <TextView
                    android:id="@+id/tv_report_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="计算详情报告"
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_user_compare_report" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Actions -->
        <LinearLayout
            android:id="@+id/bottom_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="清除数据"
                android:textColor="#666666"
                app:cornerRadius="24dp"
                app:strokeColor="#DDDDDD" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.5"
                android:backgroundTint="@color/green_kuan"
                android:text="生成计算报告"
                android:textColor="@color/white"
                app:cornerRadius="24dp"
                app:elevation="2dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
